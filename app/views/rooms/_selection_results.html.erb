<% if @room.selection_generated_at %>
  <p class="mt-3 text-sm leading-6 text-ink-muted">Сохранённая подборка для всей комнаты. После новых оценок или вступления друзей запустите подбор снова.</p>
  <% if @room.selection_results.any? %>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @room.selection_results.first(local_assigns.fetch(:limit, 12)).each do |result| %>
        <div>
          <%= render "movies/movie_card", movie: result.fetch("movie") %>
          <p class="mt-2 text-sm text-ink-muted"><%= result.fetch("reason") %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-5 text-sm leading-6 text-ink-secondary">Подходящих фильмов не найдено. Измените пожелания или разрешите показывать просмотренные фильмы.</p>
  <% end %>
<% else %>
  <div class="flex min-h-40 flex-col items-center justify-center py-6 text-center">
    <span class="grid size-12 place-items-center rounded-2xl bg-brand-soft text-brand-ink"><%= ui_icon(:film, classes: "size-6") %></span>
    <h2 class="mt-4 font-semibold">Что посмотрим вместе?</h2>
    <p class="mt-2 max-w-sm text-sm leading-6 text-ink-muted">Пригласите друзей, оцените знакомые фильмы и нажмите «Подобрать фильмы».</p>
  </div>
<% end %>
