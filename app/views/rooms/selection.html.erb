<% content_for :title, "Подбор для #{@room.name} — MovieRecommender" %>
<main class="mx-auto max-w-6xl px-5 py-6 sm:px-8 sm:py-10">
  <%= render "shared/header" %>
  <%= render "shared/flash" %>
  <%= link_to "← Вернуться в комнату", room_path(@room), class: "mb-6 inline-flex min-h-11 items-center text-sm font-medium text-ink-muted hover:text-brand-ink-hover" %>
  <header class="mb-6">
    <p class="mb-3 text-xs font-semibold tracking-widest text-brand-ink">ВЫБИРАЕМ ВМЕСТЕ</p>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Фильмы для компании</h1>
    <p class="mt-3 break-words text-sm leading-6 text-ink-muted">Комната «<%= @room.name %>». Подбор учитывает оценки участников и доступен каждому в комнате.</p>
  </header>
  <%= render "quiz_launcher" %>
  <section class="mt-6 rounded-3xl border border-line bg-surface p-6 sm:p-8" aria-label="Общая подборка">
    <%= render "selection_results" %>
  </section>
  <section class="mt-6 rounded-3xl border border-line bg-surface p-6 sm:p-8" aria-labelledby="selection-heading">
    <h2 id="selection-heading" class="mb-5 text-xl font-semibold">Обновить пожелания</h2>
    <%= render "shared/recommendation_form", destination: selection_room_path(@room), submission_method: :post, preferences: @room.selection_filters, group: true %>
  </section>
  <%= render "movies/tmdb_attribution" %>
</main>
